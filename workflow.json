    {
      "id": "d1a6c173-3f37-456a-9f75-c2463ce82243",
      "name": "Calculate Composite Health Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Mock active customer data — replace with a real CRM/DB source later\nconst customers = [\n  { accountId: 'acc-001', name: 'Acme Corp', csm: 'Dana', loginsLast30d: 120, seatsUsedPct: 0.92, openTickets: 1, nps: 9, daysToRenewal: 200 },\n  { accountId: 'acc-002', name: 'Globex Inc', csm: 'Omar', loginsLast30d: 12, seatsUsedPct: 0.35, openTickets: 6, nps: 4, daysToRenewal: 45 },\n  { accountId: 'acc-003', name: 'Initech LLC', csm: 'Dana', loginsLast30d: 58, seatsUsedPct: 0.71, openTickets: 3, nps: 7, daysToRenewal: 120 },\n  { accountId: 'acc-004', name: 'Umbrella Co', csm: 'Priya', loginsLast30d: 4, seatsUsedPct: 0.18, openTickets: 9, nps: 2, daysToRenewal: 30 },\n  { accountId: 'acc-005', name: 'Stark Industries', csm: 'Omar', loginsLast30d: 95, seatsUsedPct: 0.88, openTickets: 0, nps: 10, daysToRenewal: 300 },\n];\n\n// Composite health score (0-100): engagement 40%, adoption 25%, support 20%, sentiment 15%\nfunction score(c) {\n  const engagement = Math.min(c.loginsLast30d / 100, 1) * 40;\n  const adoption = c.seatsUsedPct * 25;\n  const support = Math.max(0, 1 - c.openTickets / 10) * 20;\n  const sentiment = (c.nps / 10) * 15;\n  return Math.round(engagement + adoption + support + sentiment);\n}\n\nreturn customers.map(c => {\n  const healthScore = score(c);\n  const riskBand = healthScore < 40 ? 'at-risk' : healthScore < 70 ? 'monitor' : 'high-health';\n  return { json: { ...c, healthScore, riskBand } };\n});"
      }
    },
    {
      "id": "51ba9bdc-9b99-441e-9226-97ed98e35d70",
      "name": "Route by Risk Score",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "at-risk",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.riskBand }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "at-risk"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "high-health",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.riskBand }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "high-health"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "monitor"
        }
      }
    },
